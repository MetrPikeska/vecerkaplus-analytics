[Unit]
Description=VečerkaPlus Analytics Dashboard
After=network.target

[Service]
Type=simple
User=metr
WorkingDirectory=/home/metr/projects/vecerkaplus-analytics
EnvironmentFile=/home/metr/projects/vecerkaplus-analytics/.env
ExecStart=/usr/bin/python3 -m streamlit run app/Home.py --server.port 8501 --server.headless true
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
